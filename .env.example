# Copy to .env and adjust. Never commit .env.
# Variable names are the Django project's, so an existing .env keeps working
# (DJANGO_SECRET_KEY, DJANGO_DEBUG and ALLOWED_HOSTS are no longer read).

# MCP
MCP_EXECUTE_TOOL_NAME=execute
MCP_JSON_RESPONSE=True
MCP_STATELESS=True

# Execution
MAX_CONCURRENCY=8
DEFAULT_CALL_TIMEOUT_SECONDS=30
HTTP_TIMEOUT_SECONDS=30
# ALLOWED_HTTP_METHODS=GET,POST,PUT,PATCH,DELETE

# Cache service (HTTP API — app/infra/cache.py talks to it over HTTP, no redis import)
CACHE_API_URL=http://localhost:8400/api/v1/cache
CACHE_HTTP_TIMEOUT_SECONDS=5
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_LARGE_RESULT_THRESHOLD=1000

# Database (MSSQL via pyodbc) — the connection string is assembled from these
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USERNAME=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_EXTRA_PARAMS='Encrypt=yes;TrustServerCertificate=yes;'
# Or bypass assembly entirely:
# DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=...;Database=...;UID=...;PWD=...

# Function allowlist (comma-separated package prefixes; empty allows every function)
FUNCTION_ALLOWLIST=polars,pandas,numpy

# Dynamic function registration (lazy install-on-first-use) — OFF by default.
# Enable to let a function tool call for an unregistered package fetch its config from
# CONFIG_API_URL, install it, and register it on first use.
# See docs/DYNAMIC_FUNCTION_REGISTRATION.md.
FUNCTION_DYNAMIC_REGISTRATION_ENABLED=False
CONFIG_API_URL=
CONFIG_API_TOKEN=
CONFIG_API_TIMEOUT_SECONDS=5
# Trust boundaries (recommended when enabled): restrict what may be installed/imported.
FUNCTION_ALLOWED_MODULE_PREFIXES=
FUNCTION_PACKAGE_INDEX_URL=
FUNCTION_NEGATIVE_CACHE_TTL_SECONDS=60

# Logging
LOG_LEVEL=INFO
